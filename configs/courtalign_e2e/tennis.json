{
  "model": "courtalign_e2e",
  "backbone": "sam3_seg_fpn",
  "backbone_trainable": true,
  "backbone_lr": 0.00003,
  "input_hw": [1008, 1008],
  "batch_size": 2,
  "lr": 0.0003,
  "weight_decay": 0.0001,
  "heat_temp": 0.35,
