{
  "method_id": "courtalign_2s",
  "experiment_id": "courtalign_2s_badminton_resnet34",
  "dataset_config": "configs/datasets/badminton_zones.json",
  "run_dir": "runs/courtalign_2s/badminton/segmentation",
  "segmentation": {
    "model_name": "DeepLabV3Plus",
    "encoder": "resnet34",
    "encoder_weights": "imagenet",
    "activation": "softmax2d",
    "freeze_encoder": false,
    "fine_tune": false
  },
  "training": {
    "seed": 20260602,
    "n_epochs": 80,
    "batch_size": 2,
    "optimizer": "adam",
    "learning_rate": 0.0001,
    "loss_function": "ThreePhaseDiceLoss",
    "loss_schedule": [
      {"name": "phase_1", "start_epoch": 1, "end_epoch": 14, "active_classes": "all"},
      {"name": "phase_2", "start_epoch": 15, "end_epoch": 15, "active_classes": ["bl_singles", "br_singles"]},
      {"name": "phase_3", "start_epoch": 16, "end_epoch": 80, "active_classes": "all"}
    ],
    "auto_batch_size": false,
    "overlay_opacity": 0.5,
    "augmentation_colour_format": "hsv",
    "augmentation_spatial": true,
    "augmentation_colour": true
  },
  "selection": {
    "split": "val",
    "criterion": "lowest comparable all-class validation Dice loss; focused phase 2 is excluded from checkpoint selection",
    "checkpoint": "checkpoints/best_model.pth"
  }
}
